<script>
  let map = null;
  let deliveryPoint = null;
  const factoryCoords = [47.129696, 39.716890]; // Батайск

  ymaps.ready(init);

  function init() {
    map = new ymaps.Map('map', {
      center: factoryCoords,
      zoom: 11,
      controls: ['zoomControl']
    });

    // Загрузка кастомной иконки завода
    const factoryIcon = new ymaps.Placemark(factoryCoords, {
      balloonContent: 'Завод "Монолит Дон", Батайск'
    }, {
      iconLayout: 'default#image',
      iconImageHref: 'https://github.com/beton61/monolit/blob/main/bg-location-map.png', // ← замените на вашу реальную картинку: 'img/factory.png'
      iconImageSize: [32, 32],
      iconImageOffset: [-16, -16]
    });
    map.geoObjects.add(factoryIcon);

    map.events.add('click', function(e) {
      const coords = e.get('coords');
      ymaps.geocode(coords).then(function(result) {
        const firstGeoObject = result.geoObjects.get(0);
        const address = firstGeoObject ? firstGeoObject.getAddressLine() : 'Адрес не определён';
        setDeliveryPoint(coords, address);
      });
    });
  }

  function findAddress() {
    const userInput = document.getElementById('addressInput').value.trim();
    if (!userInput) {
      alert('Введите адрес!');
      return;
    }

    let query = userInput;
    const lowerInput = userInput.toLowerCase();
    const cities = ['ростов', 'батайск', 'новошахтинск'];
    const hasCity = cities.some(city => lowerInput.includes(city));

    if (!hasCity) {
      query = `${userInput}, Батайск`;
    }

    ymaps.geocode(query).then(function(result) {
      const firstGeoObject = result.geoObjects.get(0);
      if (!firstGeoObject) {
        alert('Адрес не найден.');
        return;
      }

      const coords = firstGeoObject.geometry.getCoordinates();
      setDeliveryPoint(coords, query);
    }).catch(() => {
      alert('Ошибка поиска.');
    });
  }

  function findMyLocation() {
    if (!navigator.geolocation) {
      alert('Геолокация не поддерживается.');
      return;
    }

    navigator.geolocation.getCurrentPosition(
      (position) => {
        const coords = [position.coords.latitude, position.coords.longitude];
        ymaps.geocode(coords).then(function(result) {
          const firstGeoObject = result.geoObjects.get(0);
          const address = firstGeoObject ? firstGeoObject.getAddressLine() : 'Адрес не определён';
          setDeliveryPoint(coords, address);
        });
      },
      (error) => {
        alert('Не удалось определить местоположение.');
      }
    );
  }

  function setDeliveryPoint(coords, address) {
    if (deliveryPoint) {
      map.geoObjects.remove(deliveryPoint);
    }

    deliveryPoint = new ymaps.Placemark(coords, {
      balloonContent: address
    });
    map.geoObjects.add(deliveryPoint);

    map.setCenter(coords, 15);
    document.getElementById('addressInput').value = address;
    document.getElementById('deliveryAddress').value = address;
  }

  function getDistanceBetweenPoints(p1, p2) {
    const R = 6371;
    const dLat = (p2[0] - p1[0]) * Math.PI / 180;
    const dLon = (p2[1] - p1[1]) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(p1[0] * Math.PI / 180) * Math.cos(p2[0] * Math.PI / 180) *
              Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  function calculate() {
    const markVal = parseFloat(document.getElementById('mark').value);
    const volume = parseFloat(document.getElementById('volume').value);

    if (!isNaN(markVal) && !isNaN(volume) && deliveryPoint) {
      const deliveryCoords = deliveryPoint.geometry._coordinates;
      const distanceKm = getDistanceBetweenPoints(factoryCoords, deliveryCoords);
      const adjustedDistance = distanceKm + 4.5;

      let baseCost = markVal * volume;
      let deliveryCost = 0;

      if (volume <= 5) {
        deliveryCost = adjustedDistance <= 5
          ? Math.ceil(3000)
          : Math.ceil(3000 + 150 * (adjustedDistance - 5));
      } else {
        const baseDelivery = 600 * volume;
        deliveryCost = adjustedDistance <= 5
          ? Math.ceil(baseDelivery)
          : Math.ceil(baseDelivery + 190 * (adjustedDistance - 5));
      }

      const total = baseCost + deliveryCost;

      document.getElementById('costBase').textContent = baseCost.toFixed(2) + ' ₽';
      document.getElementById('costDelivery').textContent = deliveryCost + ' ₽';
      document.getElementById('costTotal').textContent = total.toFixed(2) + ' ₽';
      document.getElementById('costDetails').style.display = 'block';

      const showWarning = distanceKm > 10;
      document.getElementById('deliveryWarning').style.display = showWarning ? 'block' : 'none';

      showOrderForm();
    } else {
      alert('Введите объём и укажите точку.');
      document.getElementById('costDetails').style.display = 'none';
      document.getElementById('orderForm').style.display = 'none';
    }
  }

  function showOrderForm() {
    const form = document.getElementById('orderForm');
    form.style.display = 'block';

    if (deliveryPoint && !document.getElementById('deliveryAddress').value) {
      const addr = deliveryPoint.properties.get('balloonContent');
      if (addr && !addr.includes('Определение') && !addr.includes('Ошибка')) {
        document.getElementById('deliveryAddress').value = addr;
      }
    }

    form.scrollIntoView({ behavior: 'smooth' });
  }

  document.addEventListener('DOMContentLoaded', function() {
    const phoneInput = document.getElementById('clientPhone');
    IMask(phoneInput, {
      mask: '+{7} (000) 000-00-00'
    });
  });

  function submitOrder(method) {
    const name = document.getElementById('clientName').value.trim();
    const phone = document.getElementById('clientPhone').value.trim();
    const address = document.getElementById('deliveryAddress').value.trim();
    const comment = document.getElementById('comment').value.trim();
    const volume = document.getElementById('volume').value;
    const mark = document.getElementById('mark').options[document.getElementById('mark').selectedIndex].text;
    const baseCost = document.getElementById('costBase').textContent;
    const deliveryCost = document.getElementById('costDelivery').textContent;
    const totalCost = document.getElementById('costTotal').textContent;

    if (!name || !phone) {
      alert('Заполните имя и телефон!');
      return;
    }

    let message = `📦 Заказ бетона\n\n`
      + `🧱 Марка: ${mark}\n`
      + `㎥ Объем: ${volume} м³\n`
      + `👤 Имя: ${name}\n`
      + `📞 Телефон: ${phone}\n`
      + `📍 Адрес: ${address || 'не указан'}\n`
      + (comment ? `💬 Коммент: ${comment}\n` : '')
      + `\n💰 Стоимость:\n`
      + `Бетон: ${baseCost}\n`
      + `Доставка: ${deliveryCost}\n`
      + `Итого: ${totalCost}\n\n`;

    const warningVisible = document.getElementById('deliveryWarning').style.display === 'block';
    if (warningVisible) {
      message += `⚠️ Внимание! Стоимость доставки за пределами г. Батайск может отличаться. Уточняйте у оператора.\n\n`;
    }

    message += `Спасибо!`;

    const encodedMessage = encodeURIComponent(message);
    let url = '';

    if (method === 'whatsapp') {
      url = `https://wa.me/79110911311?text=${encodedMessage}`;
    } else if (method === 'telegram') {
      url = `https://t.me/Olegzov13?text=${encodedMessage}`;
    }

    window.open(url, '_blank');
  }

